{
  "name": "@ebonkeep/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./auth": {
      "types": "./src/domains/auth/index.ts",
      "default": "./src/domains/auth/index.ts"
    },
    "./player": {
      "types": "./src/domains/player/index.ts",
      "default": "./src/domains/player/index.ts"
    },
    "./inventory": {
      "types": "./src/domains/inventory/index.ts",
      "default": "./src/domains/inventory/index.ts"
    },
    "./combat": {
      "types": "./src/domains/combat/index.ts",
      "default": "./src/domains/combat/index.ts"
    },
    "./arena": {
      "types": "./src/domains/arena/index.ts",
      "default": "./src/domains/arena/index.ts"
    },
    "./economy": {
      "types": "./src/domains/economy/index.ts",
      "default": "./src/domains/economy/index.ts"
    },
    "./guild": {
      "types": "./src/domains/guild/index.ts",
      "default": "./src/domains/guild/index.ts"
    },
    "./leaderboard": {
      "types": "./src/domains/leaderboard/index.ts",
      "default": "./src/domains/leaderboard/index.ts"
    },
    "./garden": {
      "types": "./src/domains/garden/index.ts",
      "default": "./src/domains/garden/index.ts"
    },
    "./jobs": {
      "types": "./src/domains/jobs/index.ts",
      "default": "./src/domains/jobs/index.ts"
    },
    "./forge": {
      "types": "./src/domains/forge/index.ts",
      "default": "./src/domains/forge/index.ts"
    },
    "./crafting": {
      "types": "./src/domains/crafting/index.ts",
      "default": "./src/domains/crafting/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "vitest run -c vitest.config.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"vitest.config.ts\""
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
