{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "paths": {
      "@ebonkeep/shared": ["../../packages/shared/src/index.ts"],
      "@ebonkeep/shared/*": ["../../packages/shared/src/*"],
      "@ebonkeep/transactions/*": ["../../transactions/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "../../packages/shared"
    }
  ]
}
