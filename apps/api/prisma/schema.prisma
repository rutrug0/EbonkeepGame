generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                  String          @id @default(cuid())
  provider            String
  providerUserId      String
  username            String?         @unique
  email               String?         @unique
  passwordHash        String?
  emailVerified       Boolean         @default(false)
  emailVerifyToken    String?         @unique
  emailVerifyExpiry   DateTime?
  resetPasswordToken  String?         @unique
  resetPasswordExpiry DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  profiles            PlayerProfile[]
  transactions        Transaction[]

  @@unique([provider, providerUserId])
  @@index([email])
  @@index([username])
  @@index([emailVerifyToken])
  @@index([resetPasswordToken])
  @@map("accounts")
}

model PlayerProfile {
  id               String            @id @default(cuid())
  accountId        String
  class            String
  preferredLocale  String            @default("en")
  level            Int               @default(1)
  gearScore        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stats            PlayerStat?
  currency         CurrencyBalance?
  inventoryItems   InventoryItem[]
  inventoryLayouts InventoryLayout[]
  equipmentSlots   EquipmentSlot[]
  shopInstances        ShopInstance[]
  jobRuns              JobRun[]
  combatSessions       CombatSession[]
  combatActions        CombatAction[]
  eventProgress        EventProgress[]
  guildMembership      GuildMember?        @relation("GuildMembership")
  leadingGuild         Guild[]             @relation("GuildLeader")
  sentInvites          GuildInvite[]       @relation("GuildInvitesSent")
  receivedInvites      GuildInvite[]       @relation("GuildInvitesReceived")
  guildActivityAsActor GuildActivity[]     @relation("GuildActivityActor")
  guildActivityAsTarget GuildActivity[]    @relation("GuildActivityTarget")

  @@index([accountId])
  @@map("player_profiles")
}

model PlayerStat {
  id           String        @id @default(cuid())
  playerId     String        @unique
  strength     Int           @default(10)
  intelligence Int           @default(10)
  dexterity    Int           @default(10)
  vitality     Int           @default(10)
  initiative   Int           @default(10)
  luck         Int           @default(10)
  player       PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_stats")
}

model InventoryItem {
  id              String         @id @default(cuid())
  playerId        String
  itemCode        String
  slotKey         String
  quantity        Int            @default(1)
  itemData        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  player          PlayerProfile  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  equippedInSlot  EquipmentSlot?

  @@index([playerId])
  @@map("inventory_items")
}

model InventoryLayout {
  id        String        @id @default(cuid())
  playerId  String
  layoutKey String
  payload   Json
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  player    PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("inventory_layouts")
}

model EquipmentSlot {
  id        String        @id @default(cuid())
  playerId  String
  slotType  String
  itemId    String?       @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  player    PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  item      InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([playerId])
  @@unique([playerId, slotType])
  @@map("equipment_slots")
}

model ShopInstance {
  id         String        @id @default(cuid())
  playerId   String
  offerCode  String
  offerIndex Int           @default(0)
  itemCode   String?
  itemData   Json?
  buyPriceDucats Int       @default(0)
  soldAt     DateTime?
  refreshAt  DateTime
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  player     PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([playerId, refreshAt])
  @@unique([playerId, offerIndex])
  @@map("shop_instances")
}

model JobRun {
  id         String        @id @default(cuid())
  playerId   String
  jobType    String
  status     String
  completeAt DateTime
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  player     PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("job_runs")
}

model CombatSession {
  id        String         @id @default(cuid())
  playerId  String
  mode      String
  state     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  player    PlayerProfile  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  actions   CombatAction[]

  @@index([playerId])
  @@map("combat_sessions")
}

model CombatAction {
  id        String         @id @default(cuid())
  playerId  String
  sessionId String?
  action    String
  targetId  String?
  skillId   String?
  createdAt DateTime       @default(now())
  player    PlayerProfile  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  session   CombatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([playerId])
  @@index([sessionId])
  @@map("combat_actions")
}

model CurrencyBalance {
  id        String        @id @default(cuid())
  playerId  String        @unique
  ducats    Int           @default(0)
  imperials Int           @default(0)
  player    PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("currencies")
}

model Transaction {
  id              String    @id @default(cuid())
  accountId       String
  provider        String
  providerOrderId String    @unique
  providerPayerId String?
  status          String
  amount          String
  currency        String
  imperials       Int
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([status])
  @@index([providerOrderId])
  @@map("transactions")
}

model EventProgress {
  id        String        @id @default(cuid())
  playerId  String
  eventCode String
  payload   Json
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  player    PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("event_progress")
}

// =====================================================
// AUCTION SYSTEM MODELS
// =====================================================

model AuctionInstance {
  id              String        @id @default(cuid())
  levelBracketMin Int
  levelBracketMax Int
  startTime       DateTime
  endTime         DateTime
  status          String        @default("pending") // pending | active | settling | settled
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           AuctionItem[]

  @@index([status, endTime])
  @@index([levelBracketMin, levelBracketMax, status])
  @@map("auction_instances")
}

model AuctionItem {
  id                String  @id @default(cuid())
  auctionInstanceId String
  itemCode          String // JSON-encoded item data (temp until item system finalized)
  itemLevel         Int
  itemRarity        String
  itemCategory      String
  startingBid       Int
  currentBid        Int     @default(0)
  currentWinnerId   String?
  bidCount          Int     @default(0)
  extensionsUsed    Int     @default(0)
  maxExtensions     Int     @default(5)

  // Player submission fields
  isPlayerSubmitted Boolean @default(false)
  sellerId          String? // Player who submitted the item (null for system-generated)
  feePercentage     Int     @default(0) // Auction house fee (e.g., 5 for 5%)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  auctionInstance AuctionInstance @relation(fields: [auctionInstanceId], references: [id], onDelete: Cascade)
  bids            AuctionBid[]

  @@index([auctionInstanceId])
  @@index([currentWinnerId])
  @@index([sellerId])
  @@map("auction_items")
}

model AuctionBid {
  id          String      @id @default(cuid())
  itemId      String
  playerId    String
  bidAmount   Int
  status      String      @default("active") // active | outbid | won | refunded
  isAutoBid   Boolean     @default(false) // Whether this is an auto-bid
  maxAutoBid  Int? // Maximum amount for auto-bidding (null if not auto-bidding)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  item        AuctionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, status])
  @@index([playerId, status])
  @@index([playerId, itemId, status])
  @@index([createdAt])
  @@map("auction_bids")
}

model AuctionPendingReward {
  id         String    @id @default(cuid())
  playerId   String
  itemId     String
  itemCode   String // JSON-encoded item data
  auctionId  String
  winningBid Int
  expiresAt  DateTime
  claimed    Boolean   @default(false)
  claimedAt  DateTime? // When claimed
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([playerId, claimed])
  @@index([expiresAt])
  @@map("auction_pending_rewards")
}

model AuctionParticipation {
  id        String   @id @default(cuid())
  playerId  String
  auctionId String
  itemId    String? // null = viewing only, non-null = has active bid
  joinedAt  DateTime @default(now())

  @@unique([playerId, auctionId])
  @@index([auctionId])
  @@map("auction_participation")
}

model AuctionPlayerListing {
  id              String    @id @default(cuid())
  playerId        String // Player submitting the item
  inventoryItemId String // Reference to item in player's inventory
  itemCode        String // JSON-encoded item data
  itemLevel       Int
  itemRarity      String
  minimumBid      Int // Player-set minimum starting bid
  status          String    @default("pending") // pending | approved | rejected | listed | sold | returned
  approvedBy      String? // Admin who approved (null if auto-approved)
  approvedAt      DateTime? // When approved
  rejectedBy      String? // Admin who rejected
  rejectedAt      DateTime? // When rejected
  rejectionReason String? // Reason for rejection
  auctionItemId   String? // Reference to AuctionItem once listed (null until listed)
  listedAt        DateTime? // When added to auction
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([playerId, status])
  @@index([status])
  @@index([auctionItemId])
  @@map("auction_player_listings")
}

// ========================================
// Guild System Models
// ========================================

model Guild {
  id              String          @id @default(cuid())
  name            String          @unique
  tag             String          @unique
  description     String          @default("")
  leaderId        String
  maxMembers      Int             @default(50)
  isRecruiting    Boolean         @default(true)
  totalPower      Int             @default(0)
  level           Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  crestId         String?
  crestBgShape    String          @default("shield_01")
  crestBgColor    String          @default("crimson")
  crestBgPattern  String?
  crestFgSymbol   String          @default("sword_01")
  crestFgColor    String          @default("gold")
  crestFrame      String?
  
  leader          PlayerProfile   @relation("GuildLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  members         GuildMember[]
  invites         GuildInvite[]
  activityLog     GuildActivity[]
  
  @@index([name])
  @@index([tag])
  @@index([leaderId])
  @@index([totalPower])
  @@index([createdAt])
  @@map("guilds")
}

model GuildMember {
  id              String          @id @default(cuid())
  guildId         String
  playerId        String          @unique
  role            String          @default("member")
  joinedAt        DateTime        @default(now())
  contributedPower Int            @default(0)
  
  guild           Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  player          PlayerProfile   @relation("GuildMembership", fields: [playerId], references: [id], onDelete: Cascade)
  
  @@index([guildId])
  @@index([playerId])
  @@index([role])
  @@map("guild_members")
}

model GuildInvite {
  id              String          @id @default(cuid())
  guildId         String
  inviterId       String
  inviteeId       String
  message         String?
  status          String          @default("pending")
  expiresAt       DateTime
  createdAt       DateTime        @default(now())
  respondedAt     DateTime?
  
  guild           Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  inviter         PlayerProfile   @relation("GuildInvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee         PlayerProfile   @relation("GuildInvitesReceived", fields: [inviteeId], references: [id], onDelete: Cascade)
  
  @@unique([guildId, inviteeId, status])
  @@index([guildId])
  @@index([inviteeId, status])
  @@index([expiresAt])
  @@map("guild_invites")
}

model GuildActivity {
  id              String          @id @default(cuid())
  guildId         String
  actorId         String?
  actionType      String
  targetId        String?
  metadata        Json?
  timestamp       DateTime        @default(now())
  
  guild           Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  actor           PlayerProfile?  @relation("GuildActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  target          PlayerProfile?  @relation("GuildActivityTarget", fields: [targetId], references: [id], onDelete: SetNull)
  
  @@index([guildId, timestamp(sort: Desc)])
  @@index([actorId])
  @@map("guild_activity")
}
